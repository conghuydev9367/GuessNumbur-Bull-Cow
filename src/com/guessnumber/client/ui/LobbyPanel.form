<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.guessnumber.client.ui.LobbyPanel">
  <grid id="27dc6" binding="rootPanel" layout-manager="GridLayoutManager" row-count="4" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="5" vgap="5">
    <margin top="8" left="8" bottom="8" right="8"/>
    <constraints>
      <xy x="20" y="20" width="760" height="560"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="1" layout-manager="FlowLayout" hgap="8" vgap="4" flow-align="0">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="2" class="javax.swing.JLabel">
            <constraints/>
            <properties>
              <text value="Số chữ số:"/>
            </properties>
          </component>
          <component id="3" class="javax.swing.JSpinner" binding="digitSpinner">
            <constraints/>
            <properties/>
          </component>
          <component id="4" class="javax.swing.JButton">
            <constraints/>
            <properties>
              <text value="🏠 Tạo Phòng"/>
            </properties>
          </component>
          <component id="5" class="javax.swing.JLabel">
            <constraints/>
            <properties>
              <text value="Mã phòng:"/>
            </properties>
          </component>
          <component id="6" class="javax.swing.JTextField" binding="roomCodeField">
            <constraints/>
            <properties>
              <columns value="8"/>
            </properties>
          </component>
          <component id="7" class="javax.swing.JButton">
            <constraints/>
            <properties>
              <text value="🚪 Vào Phòng"/>
            </properties>
          </component>
        </children>
      </grid>
      <scrollpane id="8">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="9" class="javax.swing.JTextPane" binding="chatArea">
            <constraints/>
            <properties>
              <editable value="false"/>
            </properties>
          </component>
        </children>
      </scrollpane>
      <grid id="10" layout-manager="BorderLayout" hgap="5" vgap="0">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="11" class="javax.swing.JTextField" binding="chatField">
            <constraints border-constraint="Center"/>
            <properties/>
          </component>
          <component id="12" class="javax.swing.JButton">
            <constraints border-constraint="East"/>
            <properties>
              <text value="Gửi"/>
            </properties>
          </component>
        </children>
      </grid>
      <component id="c497f" class="javax.swing.JProgressBar" binding="progressBar1" default-binding="true">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
    </children>
  </grid>
</form>
