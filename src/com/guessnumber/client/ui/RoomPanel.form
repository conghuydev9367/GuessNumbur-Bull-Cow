<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.guessnumber.client.ui.RoomPanel">
  <grid id="27dc6" binding="rootPanel" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="5" vgap="5">
    <margin top="8" left="8" bottom="8" right="8"/>
    <constraints>
      <xy x="20" y="20" width="760" height="560"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="1" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="2" class="javax.swing.JLabel" binding="roomInfoLabel">
            <constraints border-constraint="West"/>
            <properties>
              <text value="Phòng: ---"/>
            </properties>
          </component>
          <component id="3" class="javax.swing.JLabel" binding="turnLabel">
            <constraints border-constraint="East"/>
            <properties>
              <text value=""/>
            </properties>
          </component>
        </children>
      </grid>
      <scrollpane id="4">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="5" class="javax.swing.JTextArea" binding="chatArea">
            <constraints/>
            <properties>
              <editable value="false"/>
              <lineWrap value="true"/>
              <wrapStyleWord value="true"/>
            </properties>
          </component>
        </children>
      </scrollpane>
      <grid id="6" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="4">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="7" layout-manager="FlowLayout" hgap="6" vgap="4" flow-align="0" use-parent-layout="false">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="8" class="javax.swing.JButton" binding="startBtn">
                <constraints/>
                <properties>
                  <text value="▶ Bắt đầu"/>
                </properties>
              </component>
              <component id="9" class="javax.swing.JLabel">
                <constraints/>
                <properties>
                  <text value="Số bí mật:"/>
                </properties>
              </component>
              <component id="10" class="javax.swing.JTextField" binding="secretField">
                <constraints/>
                <properties>
                  <columns value="10"/>
                </properties>
              </component>
              <component id="11" class="javax.swing.JButton" binding="setSecretBtn">
                <constraints/>
                <properties>
                  <text value="✅ Đặt"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="12" layout-manager="FlowLayout" hgap="6" vgap="4" flow-align="0" use-parent-layout="false">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="13" class="javax.swing.JLabel">
                <constraints/>
                <properties>
                  <text value="Đoán số:"/>
                </properties>
              </component>
              <component id="14" class="javax.swing.JTextField" binding="guessField">
                <constraints/>
                <properties>
                  <columns value="12"/>
                </properties>
              </component>
              <component id="15" class="javax.swing.JButton" binding="guessBtn">
                <constraints/>
                <properties>
                  <text value="🎯 Đoán"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="16" layout-manager="BorderLayout" hgap="5" vgap="0">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="17" class="javax.swing.JTextField" binding="chatField">
                <constraints border-constraint="Center"/>
                <properties/>
              </component>
              <grid id="18" layout-manager="FlowLayout" hgap="4" vgap="0" flow-align="2" use-parent-layout="false">
                <constraints border-constraint="East"/>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="19" class="javax.swing.JButton" binding="sendChatBtn">
                    <constraints/>
                    <properties>
                      <text value="Gửi"/>
                    </properties>
                  </component>
                  <component id="20" class="javax.swing.JButton">
                    <constraints/>
                    <properties>
                      <text value="🚪 Rời"/>
                    </properties>
                  </component>
                </children>
              </grid>
            </children>
          </grid>
        </children>
      </grid>
    </children>
  </grid>
</form>
